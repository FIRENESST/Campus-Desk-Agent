UIM_PUBLIC_URL=http://127.0.0.1:8090
# MainAgent 云 API。用户、认证、实例和会话由 MainAgent 的 PostgreSQL 保存。
UIM_MAIN_URL=http://127.0.0.1:8081
# Milvus RAG 的独立查询服务。
UIM_RAG_URL=http://127.0.0.1:8002
UIM_LLM_URL=
UIM_MCP_URL=http://127.0.0.1:8001/mcp
UIM_MINTA_URL=http://127.0.0.1:19000
# 校园日报端口与主管理器启动配置保持一致。
# CAMPUS_DIGEST_PORT=8184

# 生成独立凭据后填入。留空时对应管理或服务入口拒绝访问。
UIM_ADMIN_TOKEN=
UIM_LLM_TOKEN=
UIM_ALLOW_REMOTE_ADMIN=false
# 受管启动时由 MainProcessManager 注入 MPM_AUTH_PIPE 和 MPM_AUTH_PID。
# MAIN_AGENT_MCP_TOKEN=
# LOCAL_API_KEY=

# 一般用户可检索的范围，管理员可在请求中选择其他范围。
UIM_RAG_SCOPE=campus
# 自定义 Milvus 地址、集合或认证时，填写 RAG 查询服务使用的相同值。
# RAG_MILVUS_URI=
# RAG_COLLECTION=
# RAG_MILVUS_TOKEN=

# 如启用 MainAgent 路由反馈，填写它使用的同一个私有目录。
CLOUD_ROUTING_DATA_DIR=
# UIM_MAIN_PYTHON=
# UIM_RAG_PYTHON=
