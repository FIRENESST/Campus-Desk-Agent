# Copy to .env.cloud. No real credentials belong in this example.
# Runtime role: agent_app; do NOT put an owner/superuser DSN here.
CLOUD_DATABASE_URL=postgresql://agent_app:CHANGE_ME@127.0.0.1:55432/cloud_agent
# Optional column-scoped role editor for the online admin panel.
# CLOUD_ADMIN_ROLE_DATABASE_URL=postgresql://campus_role_editor:CHANGE_ME@127.0.0.1:55432/cloud_agent
# Use http://127.0.0.1:8082 when serving the ordinary user website locally.
CLOUD_PUBLIC_URL=http://127.0.0.1:8081
CLOUD_DEVELOPMENT=true
CLOUD_REQUIRE_VERIFIED_EMAIL=true
CLOUD_WORKERS=2
CLOUD_DB_POOL_SIZE=12
CLOUD_MAX_INSTANCES=10
CLOUD_MAX_ACTIVE_RUNS=3

# Same-checkout deployments use the existing llmServer LOCAL_PORT and LOCAL_API_KEY.
# For a separate llmServer deployment, set its URL and optional local key here.
# MAIN_AGENT_LLM_SERVER_URL=http://127.0.0.1:8000/v1

# Base URL for the MINTA campus simulation gateway. The skill appends /v1/call.
# MAIN_AGENT_MINTA_URL=http://127.0.0.1:19000
# Campus rumor-control API uses the loopback CAMPUS_RUMOR_PORT (8100 by default).
# Set a matching operator account from the rumor server in the local deployment.
# MAIN_AGENT_RUMOR_USER=main-agent
# MAIN_AGENT_RUMOR_PASSWORD=
# Set this only when the rumor service uses a custom CAMPUS_PUBLIC_ORIGIN.
# MAIN_AGENT_RUMOR_ORIGIN=
# MAIN_AGENT_MINTA_TOKEN=

# Optional absolute path on this server. Restrict the directory to the service account and local administrators.
CLOUD_ROUTING_DATA_DIR=
# Optional academic term for generating dated events. The start must be a Monday.
CLOUD_TERM_ID=
CLOUD_TERM_NAME=
CLOUD_TERM_START=
# Optional local navigation directory shared with UserWebsite.
CAMPUS_NAVIGATION_DIR=
# Comma-separated allowlists; leave empty until official sources are configured.
CLOUD_RUMOR_OFFICIAL_DOMAINS=
CLOUD_RUMOR_OFFICIAL_WEIBO_IDS=
# Local RAG port for routing embeddings. Set to 0 to use only text matching.
# CLOUD_ROUTING_EMBEDDING_PORT=8002
# MAIN_AGENT_LLM_SERVER_API_KEY=

# Presets: qq, 163, 126, yeah, gmail, outlook. Leave empty before setting up mail.
CLOUD_SMTP_PROVIDER=
CLOUD_SMTP_USER=
CLOUD_SMTP_PASSWORD=
CLOUD_SMTP_FROM=
# Outlook uses OAuth2. Gmail can opt into OAuth2.
# CLOUD_SMTP_AUTH=oauth2
# CLOUD_SMTP_OAUTH_CLIENT_ID=
# CLOUD_SMTP_OAUTH_CLIENT_SECRET=
# CLOUD_SMTP_OAUTH_REFRESH_TOKEN=

# Optional, server-controlled Python factory returning a Runner.
# CLOUD_RUNNER_FACTORY=my_cloud_backend:create_runner
# Owner DSN is needed only for the separate migration command.
# Prefer supplying it temporarily through an environment variable.
# CLOUD_MIGRATION_DATABASE_URL=postgresql://OWNER:CHANGE_ME@127.0.0.1:55432/cloud_agent

# Microsoft To Do: register a Web app supporting personal Microsoft accounts and Microsoft 365 accounts.
# Delegated Graph permissions: Tasks.ReadWrite and User.Read. The authorization also requests offline_access.
# Generate the token key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOUD_TODO_CLIENT_ID=
CLOUD_TODO_CLIENT_SECRET=
CLOUD_TODO_REDIRECT_URI=
CLOUD_TODO_TOKEN_KEY=

# Campus SSO: choose oidc, cas, or saml2; empty disables campus SSO.
# Email/password login remains available with any selection.
CLOUD_SSO_PROTOCOL=
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Share this secret across all API replicas. Never use the example placeholder.
CLOUD_SSO_STATE_SECRET=

# OIDC: authorization code + S256 PKCE, signed RS256 ID tokens.
CLOUD_OIDC_ISSUER=
CLOUD_OIDC_CLIENT_ID=
CLOUD_OIDC_CLIENT_SECRET=
CLOUD_OIDC_TOKEN_AUTH_METHOD=client_secret_basic

# Set true with CLOUD_SSO_PROTOCOL=cas for the project-owned CAS server.
CLOUD_CAS_LOCAL=false
# External CAS 2/3 only: fixed HTTPS base, serviceValidate or p3/serviceValidate.
CLOUD_CAS_BASE_URL=
CLOUD_CAS_VALIDATION_PATH=p3/serviceValidate
CLOUD_CAS_EMAIL_ATTRIBUTE=mail
# Enable only if the school guarantees the attribute is verified and authoritative.
CLOUD_CAS_TRUST_EMAIL=false

# SAML 2: SP-initiated Redirect -> POST, persistent NameID, signed response/assertion.
CLOUD_SAML_IDP_ENTITY_ID=
CLOUD_SAML_IDP_SSO_URL=
CLOUD_SAML_IDP_CERT_FILE=
CLOUD_SAML_SP_ENTITY_ID=
# Optional SP request signing certificate/private key (PEM files).
CLOUD_SAML_SP_CERT_FILE=
CLOUD_SAML_SP_KEY_FILE=
CLOUD_SAML_EMAIL_ATTRIBUTE=mail
CLOUD_SAML_TRUST_EMAIL=false
