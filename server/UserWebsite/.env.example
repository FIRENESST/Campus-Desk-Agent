# 本地默认值。生产部署时将 PUBLIC_URL 设置为 HTTPS 对外源。
USER_WEB_HOST=127.0.0.1
USER_WEB_PORT=8082
USER_WEB_PUBLIC_URL=http://127.0.0.1:8082
USER_WEB_UIM_URL=http://127.0.0.1:8090
# Optional local navigation directory shared with MainAgent.
CAMPUS_NAVIGATION_DIR=
# 只有该 IP 可以提供单个 X-Forwarded-For 客户端地址。
# USER_WEB_TRUSTED_PROXY=127.0.0.1
